# This is a Go template, see oauth_issuers_test.go.
apiVersion: aigateway.envoyproxy.io/v1beta1
kind: MCPRoute
metadata:
  name: mcp-route
  namespace: default
spec:
  parentRefs:
    - name: aigw-run
      kind: Gateway
      group: gateway.networking.k8s.io
  path: "/mcp"
  backendRefs:
    - name: backend
      kind: Backend
      group: gateway.envoyproxy.io
      path: "/mcp"
  securityPolicy:
    oauth:
      issuer: "{{ .Primary }}"
      additionalIssuers:
        - issuer: "{{ .WithoutMetadata }}"
        - issuer: "{{ .UnreachableKeys }}"
          jwksUri: "{{ .UnreachableJWKSURI }}"
        - issuer: "{{ .Additional }}"
      audiences:
        - "{{ .Audience }}"
      claimToHeaders:
        - claim: sub
          header: x-user-sub
      protectedResourceMetadata:
        resource: "{{ .Audience }}"
        scopesSupported:
          - "{{ .Scope }}"
    authorization:
      defaultAction: Deny
      rules:
        - source:
            jwt:
              scopes:
                - "{{ .Scope }}"
          target:
            tools:
              - backend: backend
                tool: echo
          action: Allow
---
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: Backend
metadata:
  name: backend
  namespace: default
spec:
  endpoints:
    - ip:
        address: 127.0.0.1
        port: {{ .BackendPort }}
---
apiVersion: gateway.networking.k8s.io/v1
kind: GatewayClass
metadata:
  name: aigw-run
spec:
  controllerName: gateway.envoyproxy.io/gatewayclass-controller
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: aigw-run
  namespace: default
spec:
  gatewayClassName: aigw-run
  listeners:
    - name: http
      protocol: HTTP
      port: 1975
  infrastructure:
    parametersRef:
      group: gateway.envoyproxy.io
      kind: EnvoyProxy
      name: envoy-ai-gateway
---
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: EnvoyProxy
metadata:
  name: envoy-ai-gateway
  namespace: default
spec:
  logging:
    level:
      default: error
  bootstrap:
    type: Merge
    value: |-
      admin:
        address:
          socket_address:
            address: 127.0.0.1
            port_value: 9901
